# Required: get a key from https://my.plantnet.org
PLANTNET_API_KEY=

# Optional: enable Google Lens matches by supplying both keys
# SerpApi: https://serpapi.com
SERPAPI_API_KEY=
# imgbb: https://api.imgbb.com
IMGBB_API_KEY=

# Minimum Pl@ntNet confidence required to accept a match (0-1)
MIN_SCORE=0.20
